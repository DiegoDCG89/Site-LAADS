# Copie para .env (uso local) e cadastre as MESMAS variáveis no Vercel (Settings > Environment Variables).
# Nunca versione o .env.

# --- Painel ---------------------------------------------------------------
# Texto longo e aleatório que assina o cookie de login:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Senha de acesso ao /admin. Prefira o hash (python scripts/hash_password.py) em vez da senha em texto.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# --- Google Sheets (banco de dados) e Drive (imagens) ------------------------
# ID da planilha: o trecho entre /d/ e /edit na URL.
SPREADSHEET_ID=
# ID da pasta do Drive: o trecho final da URL da pasta.
DRIVE_FOLDER_ID=

# Opção A (recomendada): OAuth da sua conta Google. Gere o token com  python scripts/get_refresh_token.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Opção B: conta de serviço (JSON em uma linha ou em base64). O Drive só aceita envio em Drive compartilhado.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Opcional ---------------------------------------------------------------
# CACHE_TTL=30               # segundos de cache do conteúdo no servidor
# PUBLIC_CACHE_SECONDS=60    # segundos de cache da página na CDN do Vercel
# TIMEZONE=America/Sao_Paulo
